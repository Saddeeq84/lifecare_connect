rules_version = '2';
service cloud.firestore {
    // WALLETS COLLECTION
    match /wallets/{walletId} {
      // Allow authenticated users to read any wallet
      allow read: if request.auth != null;
      // Allow authenticated users to create/update any wallet (needed for crediting providers/admins)
      allow create, update: if request.auth != null;
      // Only admin can delete wallets
      allow delete: if isAdmin();
    }
  match /databases/{database}/documents {
    // FACILITIES COLLECTION - Allow public read/list for facility selection
    match /facilities/{facilityId} {
      // Allow anyone to read and list facilities for dropdowns and selection
      allow read, list: if true;
      // Only authenticated users can write
      allow write: if isAuthenticated();
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // MESSAGES COLLECTION - Unified messaging
    match /messages/{messageId} {
      // Allow authenticated users to read and write messages
      allow read, write: if isAuthenticated();
      // Admin can delete any message
      allow delete: if isAdmin();
      // List: allow for authenticated users
      allow list: if isAuthenticated();
    }

    // LEGACY CHAT MESSAGES COLLECTION - Real-time chat during calls (backup)
    match /chatMessages/{messageId} {
      // Allow reading only messages from user's session
      allow read: if resource.data.sessionReference != null;
      // Allow creating messages during calls (session validation done in client)
      allow create: if request.auth != null || true; // Temporary open for video calls
      // Allow listing for real-time updates (filtered by client)
      allow list: if true;
      // Chat messages auto-delete after calls
      allow delete: if true;
    }

    // SESSION-SPECIFIC CHAT COLLECTION - Private chat per session
    match /sessionChats/{sessionId} {
      // Allow reading session chat metadata
      allow read, write: if true; // Session validation done in nested collection
      
      // Session messages - only visible to session participants
      match /messages/{messageId} {
        // Allow reading messages only if user is participant of this session
        allow read: if resource.data.sessionId == sessionId;
        // Allow creating messages if user has session access
        allow create: if request.resource.data.sessionId == sessionId;
        // Allow listing messages for real-time updates within session
        allow list: if request.query.limit <= 100; // Limit query size
        // No deletion of messages during active sessions
        allow delete: if false;
      }
    }

    // CALL SESSIONS COLLECTION - Session management during calls
    match /callSessions/{sessionId} {
      // Allow reading session data for participants
      allow read: if true; // Client validates participation
      // Allow creating/updating session data during video calls
      allow write, create: if true; // Session management needs flexibility
      // Allow listing for real-time updates
      allow list: if true;
      // Allow delete for cleanup
      allow delete: if true;
    }

    // BLOCK WRITES TO OLD MESSAGING COLLECTIONS
    match /chats/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    match /conversations/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }

    // 🔧 UTILITY FUNCTIONS
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUser().role;
    }

    function isApproved() {
      return getUser().isApproved == true;
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole() == role && isApproved();
    }

    function isAdmin() {
      return isRole("admin");
    }

    function isDoctor() {
      return isRole("doctor");
    }

    function isFacility() {
      return isRole("facility");
    }

    function isPatient() {
      return isRole("patient");
    }

    function isCHW() {
      return isRole("chw");
    }

    // CHW can act without needing isApproved
    function isCHWWithoutApproval() {
      return isAuthenticated() && getUserRole() == "chw";
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == "superadmin";
    }

    // 👥 USERS COLLECTION
    match /users/{userId} {
      // Allow anyone to read for duplicate check
      allow read: if true;

      // Allow staff to read/write their own profile if authenticated and userId matches their staffId in token
      allow read, write: if isAuthenticated() && (request.auth.token.staffId == userId);

      // Allow authenticated users to create their own account (for other roles)
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Admin can read and write all user data
      allow read, write: if isAdmin();

      // CHW can create patient profiles
      allow create: if isCHWWithoutApproval() &&
        request.resource.data.role == 'patient' &&
        request.resource.data.createdBy == request.auth.uid;

      // Only admin can delete user profiles
      allow delete: if isAdmin();

      // List permissions for specific user types
      allow list: if isAuthenticated() && (isAdmin() || isDoctor() || isCHWWithoutApproval() || isFacility());
    }

    // 📚 TRAINING MATERIALS COLLECTION - RELAXED FOR DEBUGGING
    match /training_materials/{materialId} {
      // TEMPORARY: Allow all authenticated users to read for debugging
      allow read, list: if isAuthenticated();
      
      // Admin can create, update, and delete training materials
      allow write, delete: if isAdmin();
      
      // CHWs can update download count and completion status only
      allow update: if isCHWWithoutApproval() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'completionStatus', 'lastAccessedBy', 'lastAccessedAt', 'viewCount']);
    }

    // 📅 APPOINTMENTS COLLECTION
    match /appointments/{appointmentId} {
      // Patient access - can create and view their own appointments (more permissive)
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      
      // Healthcare provider access - can view and manage appointments
      allow read, update: if (isDoctor() || isCHWWithoutApproval() || isFacility()) && 
        (resource.data.facilityId == request.auth.uid || 
         resource.data.doctorId == request.auth.uid ||
         resource.data.chwId == request.auth.uid ||
         resource.data.providerId == request.auth.uid);
      
      // CHW specific access for appointments they handle
      allow create: if isCHWWithoutApproval() && 
        (request.resource.data.chwId == request.auth.uid ||
         request.resource.data.providerId == request.auth.uid);
      
      // Admin full access
      allow read, write, delete: if isAdmin();
      
      // List permissions for all authenticated users
      allow list: if isAuthenticated();
    }

    // HEALTH RECORDS COLLECTION - Unified access
    match /health_records/{recordId} {
      // Patients can read their own health records
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      // Doctors can read records where they are the provider (support both providerId and doctorId)
      allow read: if isDoctor() && (resource.data.providerId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      // CHWs and Facilities can read/write if they are assigned to the record
      allow read, write: if isAuthenticated() && (
        isCHWWithoutApproval() || isFacility()
      );
      // Doctors, CHWs, and Facilities can write if they are assigned
      allow write: if isDoctor() || isCHWWithoutApproval() || isFacility();
      // Admin can do anything
      allow read, write, delete: if isAdmin();
      // List: allow for authenticated users (filtered by security rules above)
      allow list: if isAuthenticated();
    }

    // BLOCK WRITES TO OLD COLLECTIONS
    match /consultations/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    match /lab_request/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    match /prescriptions/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }

    // All other collections with basic rules...
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
