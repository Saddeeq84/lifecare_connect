rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BLOCKED EMAILS COLLECTION - Prevents email reuse for deleted staff
    match /blocked_emails/{email} {
      // Anyone can read to check if email is blocked
      allow read: if true;
      // Only authenticated facility admins can create blocked emails
      allow create: if isAuthenticated() && isFacility();
      // Admin can manage all blocked emails
      allow write, delete: if isAdmin();
    }

    // FACILITY STAFF COLLECTIONS - Dynamic collections per facility
    match /{facilityCollection}/{staffId} {
      // Match any collection ending with "_users" (facility staff collections)
      
      // SPECIAL: Allow email verification without authentication
      // Allows reading to check current status and updating verification fields
      allow read: if facilityCollection.matches('.*_users$');
      allow update: if facilityCollection.matches('.*_users$') &&
        request.resource.data.emailVerified == true &&
        request.resource.data.status == 'active';
      
      // Standard authenticated access for facility admins
      allow write: if facilityCollection.matches('.*_users$') && 
        (isAuthenticated() && (isFacility() || isAdmin()));
      allow delete: if facilityCollection.matches('.*_users$') && 
        (isFacility() || isAdmin());
      // List staff for facility admins
      allow list: if facilityCollection.matches('.*_users$') && 
        (isAuthenticated() && (isFacility() || isAdmin()));
    }

    // WALLETS COLLECTION
    match /wallets/{walletId} {
      // Allow anyone to read wallets (including unauthenticated staff)
      allow read: if true;
      // Allow anyone to create/update wallets (staff need this for appointment bookings)
      // Note: Staff are not Firebase authenticated, so request.auth is null
      allow create, update: if true;
      // Only admin can delete wallets
      allow delete: if isAdmin();
      
      // Wallet transactions subcollection
      match /transactions/{transactionId} {
        // Allow anyone to read transactions
        allow read: if true;
        // Allow anyone to create transactions (staff need this)
        allow create: if true;
        // Only admin can delete transactions
        allow delete: if isAdmin();
      }
    }

    // WALLET TRANSACTIONS COLLECTION - Top-level transaction records
    match /wallet_transactions/{transactionId} {
      // Allow anyone to read wallet transactions
      allow read, list: if true;
      // Allow anyone to create wallet transactions (phone-authenticated patients need this)
      allow create: if true;
      // Only admin can delete transactions
      allow delete: if isAdmin();
    }

    // FACILITY PATIENTS COLLECTION - For facilities that register patients directly (e.g., Sunhive Health Care)
    match /facility_patients/{patientId} {
      // Allow anyone to read patients (needed for staff access)
      allow read, list: if true;
      
      // Allow creating/updating if facilityId is present (staff are not Firebase authenticated)
      allow create, update: if request.resource.data.facilityId != null;
      
      // Admin can do anything
      allow read, write, delete: if isAdmin();
      
      // CONSULTATIONS SUBCOLLECTION - Allow staff to create consultations
      match /consultations/{consultationId} {
        // Allow anyone to read and create consultations (staff need this)
        allow read, create: if true;
        // Allow updates for authenticated users
        allow update: if isAuthenticated() || true;
        // Only admin can delete
        allow delete: if isAdmin();
      }
      
      // TRANSACTIONS SUBCOLLECTION - Allow staff to create transactions
      match /transactions/{transactionId} {
        // Allow anyone to read and create transactions (staff need this)
        allow read, create: if true;
        // Only admin can delete
        allow delete: if isAdmin();
      }
      
      // LAB RESULTS SUBCOLLECTION - Allow lab staff to create lab results
      match /lab_results/{resultId} {
        // Allow anyone to read and create lab results (lab staff need this)
        allow read, create: if true;
        // Allow updates for authenticated users
        allow update: if true;
        // Only admin can delete
        allow delete: if isAdmin();
      }
      
      // WALLET SUBCOLLECTION - Allow staff to manage patient wallets
      match /wallet/{walletId} {
        // Allow anyone to read and update wallets (staff need this for billing)
        allow read, update: if true;
        // Allow anyone to create wallets
        allow create: if true;
        // Only admin can delete
        allow delete: if isAdmin();
      }
    }

    // HOUSEHOLDS COLLECTION - For Sunhive Health Care facilities to manage households
    match /households/{householdId} {
      // Facility can read, create, and update their own households
      allow read, create, update: if isAuthenticated() && 
        (isFacility() && resource.data.facilityId == request.auth.uid);
      // Allow facility to create new households
      allow create: if isAuthenticated() && 
        (isFacility() && request.resource.data.facilityId == request.auth.uid);
      // Facility can delete their own households (if no beneficiaries)
      allow delete: if isAuthenticated() && 
        (isFacility() && resource.data.facilityId == request.auth.uid);
      // Admin can do anything
      allow read, write, delete: if isAdmin();
      // List: allow for authenticated facilities and admins
      allow list: if isAuthenticated() && (isFacility() || isAdmin());
    }

    // HOUSEHOLD WALLETS COLLECTION - For managing household finances
    match /household_wallets/{householdId} {
      // Allow anyone to read, create, and update household wallets (staff need this)
      allow read, create, update: if true;
      // Admin can do anything
      allow read, write, delete: if isAdmin();
      // List: allow for anyone
      allow list: if true;
      
      // Household wallet transactions subcollection
      match /transactions/{transactionId} {
        // Allow anyone to read transactions
        allow read: if true;
        // Allow anyone to create transactions (staff need this)
        allow create: if true;
        // Only admin can delete transactions
        allow delete: if isAdmin();
      }
    }
    
    // PENDING PRESCRIPTIONS COLLECTION - For pharmacy
    match /pending_prescriptions/{prescriptionId} {
      // Allow anyone to read and create (staff need this)
      allow read, create: if true;
      // Allow updates for processing
      allow update: if true;
      // Only admin can delete
      allow delete: if isAdmin();
      // Allow listing
      allow list: if true;
    }
    
    // PENDING LAB TESTS COLLECTION - For laboratory
    match /pending_lab_tests/{testId} {
      // Allow anyone to read and create (staff need this)
      allow read, create: if true;
      // Allow updates for processing
      allow update: if true;
      // Only admin can delete
      allow delete: if isAdmin();
      // Allow listing
      allow list: if true;
    }
    
    // LAB SAMPLES COLLECTION - For sample collection and tracking
    match /lab_samples/{sampleId} {
      // Allow anyone to read and create lab samples (lab staff need this)
      allow read, create: if true;
      // Allow updates for sample status changes
      allow update: if true;
      // Only admin can delete
      allow delete: if isAdmin();
      // Allow listing
      allow list: if true;
    }
    
    // LAB RESULTS COLLECTION - For storing lab test results
    match /lab_results/{resultId} {
      // Allow anyone to read and create lab results (lab staff need this)
      allow read, create: if true;
      // Allow updates for result modifications
      allow update: if true;
      // Only admin can delete
      allow delete: if isAdmin();
      // Allow listing
      allow list: if true;
    }
    
    // PENDING IMAGING COLLECTION - For radiology
    match /pending_imaging/{imagingId} {
      // Allow anyone to read and create (staff need this)
      allow read, create: if true;
      // Allow updates for processing
      allow update: if true;
      // Only admin can delete
      allow delete: if isAdmin();
      // Allow listing
      allow list: if true;
    }
    
    // DISPENSING HISTORY COLLECTION - For pharmacy audit trail
    match /dispensing_history/{historyId} {
      // Allow anyone to read and create (pharmacy staff need this)
      allow read, create: if true;
      // Only admin can delete
      allow delete: if isAdmin();
      // Allow listing
      allow list: if true;
    }
    
    // PHARMACY INVENTORY COLLECTION - For pharmacy stock management
    match /pharmacy_inventory/{itemId} {
      // Allow anyone to read and write (pharmacy staff need this)
      allow read, list, write: if true;
      // Only admin can delete
      allow delete: if isAdmin();
    }
    
    // PHARMACY SALES COLLECTION - For standalone pharmacy sales records
    match /pharmacy_sales/{saleId} {
      // Allow anyone to read sales records
      allow read, list: if true;
      // Allow anyone to create sales (pharmacy staff need this)
      allow create: if true;
      // Allow updates for pharmacy staff
      allow update: if true;
      // Only admin can delete
      allow delete: if isAdmin();
    }
    
    // 🔧 UTILITY FUNCTIONS
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUser().role;
    }

    function isApproved() {
      return getUser().isApproved == true;
    }

    function isRole(role) {
      return isAuthenticated() && getUserRole() == role && isApproved();
    }

    function isAdmin() {
      return isRole("admin");
    }

    function isDoctor() {
      return isRole("doctor");
    }

    function isFacility() {
      return isRole("facility");
    }

    function isPatient() {
      return isRole("patient");
    }

    function isCHW() {
      return isRole("chw");
    }

    // CHW can act without needing isApproved
    function isCHWWithoutApproval() {
      return isAuthenticated() && getUserRole() == "chw";
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == "superadmin";
    }

    function isCertificateFeeFree(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId)) &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.certificateFee <= 0;
    }

    function isOwnCertificateAccessId(accessId, courseId) {
      return isAuthenticated() &&
        accessId == request.auth.uid + '_' + courseId;
    }

    function isValidCertificateAccessPayload() {
      return request.resource.data.keys().hasAll([
          'userId',
          'courseId',
          'paid',
          'freeGranted',
          'amount'
        ]) &&
        request.resource.data.keys().hasOnly([
          'userId',
          'courseId',
          'paid',
          'freeGranted',
          'amount',
          'paidAt',
          'grantedAt',
          'grantedReason'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.courseId is string &&
        request.resource.data.amount is number &&
        (
          (
            request.resource.data.paid == true &&
            request.resource.data.freeGranted == false &&
            request.resource.data.amount > 0 &&
            exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId)) &&
            request.resource.data.amount ==
              get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.certificateFee
          ) ||
          (
            request.resource.data.paid == false &&
            request.resource.data.freeGranted == true &&
            request.resource.data.amount == 0 &&
            isCertificateFeeFree(request.resource.data.courseId)
          )
        );
    }

    function hasCertificateAccess(certificateDocId) {
      return exists(/databases/$(database)/documents/certificateAccess/$(certificateDocId)) &&
        (
          get(/databases/$(database)/documents/certificateAccess/$(certificateDocId)).data.paid == true ||
          get(/databases/$(database)/documents/certificateAccess/$(certificateDocId)).data.freeGranted == true
        );
    }
    // FACILITIES COLLECTION - Allow public read/list for facility selection
    match /facilities/{facilityId} {
      // Allow anyone to read and list facilities for dropdowns and selection
      allow read, list: if true;
      // Only authenticated users can write
      allow write: if isAuthenticated();
      // Only admin can delete
      allow delete: if isAdmin();
      
      // WARDS SUBCOLLECTION - Ward management
      match /wards/{wardId} {
        // Allow anyone to read wards
        allow read, list: if true;
        // Allow updates if facilityId matches (staff need this)
        allow create, update: if true;
        // Allow delete for facility staff (nested collection, facilityId is implied)
        allow delete: if true;
        
        // BEDS SUBCOLLECTION - Bed management within wards
        match /beds/{bedId} {
          // Allow anyone to read beds
          allow read, list: if true;
          // Allow updates for bed status (staff need this for admissions)
          allow create, update: if true;
          // Allow delete for facility staff
          allow delete: if true;
        }
      }
    }

    // MESSAGES COLLECTION - Unified messaging
    match /messages/{messageId} {
      // Allow anyone to read, create, and update messages (phone-authenticated patients need this)
      allow read, create, update: if true;
      // Allow authenticated users full write access
      allow write: if isAuthenticated();
      // Admin can delete any message
      allow delete: if isAdmin();
      // List: allow for everyone (phone-authenticated patients need this)
      allow list: if true;
      
      // SUBCOLLECTION: Individual messages within conversations
      match /messages/{messageSubId} {
        // Allow unauthenticated access for video call sessions
        allow read, write, list: if true; // Open for video call functionality
        // Admin can delete any message
        allow delete: if isAdmin();
      }
    }

    // LEGACY CHAT MESSAGES COLLECTION - Real-time chat during calls (backup)
    match /chatMessages/{messageId} {
      // Allow reading only messages from user's session
      allow read: if resource.data.sessionReference != null;
      // Allow creating messages during calls (session validation done in client)
      allow create: if request.auth != null || true; // Temporary open for video calls
      // Allow listing for real-time updates (filtered by client)
      allow list: if true;
      // Chat messages auto-delete after calls
      allow delete: if true;
    }

    // SESSION-SPECIFIC CHAT COLLECTION - Private chat per session
    match /sessionChats/{sessionId} {
      // Allow reading session chat metadata
      allow read, write: if true; // Session validation done in nested collection
      
      // Session messages - only visible to session participants
      match /messages/{messageId} {
        // Allow reading messages only if user is participant of this session
        allow read: if resource.data.sessionId == sessionId;
        // Allow creating messages if user has session access
        allow create: if request.resource.data.sessionId == sessionId;
        // Allow listing messages for real-time updates within session
        allow list: if request.query.limit <= 100; // Limit query size
        // No deletion of messages during active sessions
        allow delete: if false;
      }
    }

    // CALL SESSIONS COLLECTION - Session management during calls
    match /callSessions/{sessionId} {
      // Allow reading session data for participants
      allow read: if true; // Client validates participation
      // Allow creating/updating session data during video calls
      allow write, create: if true; // Session management needs flexibility
      // Allow listing for real-time updates
      allow list: if true;
      // Allow delete for cleanup
      allow delete: if true;
    }

    // BLOCK WRITES TO OLD MESSAGING COLLECTIONS
    match /chats/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    // CONVERSATIONS COLLECTION - Department-to-department messaging
    match /conversations/{docId} {
      // Allow anyone to read conversations (facility staff need this)
      allow read: if true;
      
      // Allow creating department conversations with required fields
      // Support both old format (single 'department') and new format ('departments' array)
      // Also allow patient_facility conversations (for pharmacy orders, appointments, etc.)
      allow create: if (request.resource.data.type == 'department' &&
        request.resource.data.keys().hasAll(['facilityName', 'participants']) &&
        (request.resource.data.keys().hasAny(['department', 'departments']))) ||
        (request.resource.data.type == 'patient_facility' &&
        request.resource.data.keys().hasAll(['participantIds', 'type']));
      
      // Allow updating conversations (for last message, timestamps, participants array)
      allow update: if true;
      
      // Only admin can delete conversations
      allow delete: if isAdmin();
      
      // Allow listing conversations
      allow list: if true;
      
      // Messages subcollection within conversations
      match /messages/{messageId} {
        // Allow anyone to read messages
        allow read, list: if true;
        // Allow anyone to create messages (staff need this)
        allow create: if true;
        // Only admin can delete messages
        allow delete: if isAdmin();
      }
    }

    //  USERS COLLECTION
    match /users/{userId} {
      // Allow anyone to read for duplicate check
      allow read: if true;

      // Allow staff to read/write their own profile if authenticated and userId matches their staffId in token
      allow read, write: if isAuthenticated() && (request.auth.token.staffId == userId);

      // Allow authenticated users to create and update their own account (for doctors, CHWs, facilities, etc.)
      allow create, update: if isAuthenticated() && request.auth.uid == userId;

      // Admin can read and write all user data
      allow read, write: if isAdmin();

      // CHW can create patient profiles
      allow create: if isCHWWithoutApproval() &&
        request.resource.data.role == 'patient' &&
        request.resource.data.createdBy == request.auth.uid;

      // Only admin can delete user profiles
      allow delete: if isAdmin();

      // List permissions for specific user types
      allow list: if isAuthenticated() && (isAdmin() || isDoctor() || isCHWWithoutApproval() || isFacility());
    }

    // 📚 TRAINING MATERIALS COLLECTION - PUBLIC READ ACCESS
    match /training_materials/{materialId} {
      // Allow anyone to read training materials (including phone-authenticated patients)
      allow read, list: if true;
      
      // Admin can create, update, and delete training materials
      allow write, delete: if isAdmin();
      
      // CHWs can update download count and completion status only
      allow update: if isCHWWithoutApproval() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount', 'completionStatus', 'lastAccessedBy', 'lastAccessedAt', 'viewCount']);
    }

    // 📹 HELP VIDEOS COLLECTION - PUBLIC READ ACCESS
    match /help_videos/{videoId} {
      // Allow anyone to read help videos (including phone-authenticated patients)
      allow read, list: if true;
      
      // Allow anyone to update view count
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']);
      
      // Admin can create, update, and delete help videos
      allow write, delete: if isAdmin();
    }

    // 📅 APPOINTMENTS COLLECTION
    match /appointments/{appointmentId} {
      // Patient access - can create and view their own appointments (more permissive)
      // Support both Firebase Auth users and phone-authenticated users (Termii)
      allow create: if (isAuthenticated() && request.resource.data.patientId == request.auth.uid) ||
        (request.resource.data.patientId != null && 
         exists(/databases/$(database)/documents/users/$(request.resource.data.patientId)));
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) ||
        (resource.data.patientId != null && 
         exists(/databases/$(database)/documents/users/$(resource.data.patientId)));
      
      // Patient can update (cancel) their own appointments
      // Support both Firebase Auth users and phone-authenticated users
      allow update: if (isAuthenticated() && resource.data.patientId == request.auth.uid) ||
        (resource.data.patientId != null && 
         exists(/databases/$(database)/documents/users/$(resource.data.patientId)) &&
         request.resource.data.status == 'cancelled');
      
      // Healthcare provider access - can view and manage appointments
      allow read, update: if (isDoctor() || isCHWWithoutApproval() || isFacility()) && 
        (resource.data.facilityId == request.auth.uid || 
         resource.data.doctorId == request.auth.uid ||
         resource.data.chwId == request.auth.uid ||
         resource.data.providerId == request.auth.uid);
      
      // CHW specific access for appointments they handle
      allow create: if isCHWWithoutApproval() && 
        (request.resource.data.chwId == request.auth.uid ||
         request.resource.data.providerId == request.auth.uid);
      
      // FACILITY STAFF ACCESS (unauthenticated) - Allow creation if required fields present
      // Staff can create appointments with facilityId, patientId, bookedBy, and bookedById
      allow create: if request.resource.data.keys().hasAll([
        'facilityId', 'patientId', 'bookedBy', 'bookedById', 'status'
      ]) && request.resource.data.facilityId != null &&
      request.resource.data.patientId != null;
      
      // FACILITY STAFF UPDATE ACCESS - Allow updating appointments (approve/reject) for their facility
      // Staff can update appointments that belong to their facility
      allow update: if resource.data.facilityId != null;
      
      // FACILITY STAFF DELETE ACCESS - Allow deleting appointments for their facility
      // Medical records staff can cancel/delete appointments by checking facilityId
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
      
      // Allow listing for anyone (filtered on client side)
      allow list: if true;
    }

    // REFERRALS COLLECTION - OPD to Specialist referrals
    match /referrals/{referralId} {
      // Allow creating referrals with required fields
      allow create: if request.resource.data.keys().hasAll([
        'patientId', 'patientName', 'fromFacilityId', 'fromDoctorId', 
        'specialistDepartment', 'status'
      ]) && request.resource.data.patientId != null &&
      request.resource.data.fromFacilityId != null &&
      request.resource.data.status == 'pending';
      
      // Allow reading referrals for facilities involved
      allow read: if resource.data.fromFacilityId != null;
      
      // Allow updating referrals (accept/reject) for specialist staff
      allow update: if resource.data.fromFacilityId != null &&
        request.resource.data.status in ['pending', 'accepted', 'rejected'] &&
        // Ensure required fields are present on updates
        request.resource.data.keys().hasAll(['status', 'updatedAt']);
      
      // Admin full access
      allow read, write, delete: if isAdmin();
      
      // Allow listing for facilities
      allow list: if true;
    }

    // HEALTH RECORDS COLLECTION - Unified access
    match /health_records/{recordId} {
      // Patients can read their own health records
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      // Doctors can read records where they are the provider (support both providerId and doctorId)
      allow read: if isDoctor() && (resource.data.providerId == request.auth.uid || resource.data.doctorId == request.auth.uid);
      // CHWs and Facilities can read/write if they are assigned to the record
      allow read, write: if isAuthenticated() && (
        isCHWWithoutApproval() || isFacility()
      );
      // Doctors, CHWs, and Facilities can write if they are assigned
      allow write: if isDoctor() || isCHWWithoutApproval() || isFacility();
      
      // FACILITY STAFF ACCESS (unauthenticated) - Allow more flexible creation
      // Allow creating health records with basic required fields (patientId, facilityId, recordType)
      // Department validation is optional - if included, must be from approved list
      allow create, update: if request.resource.data.keys().hasAll([
        'patientId'
      ]) && request.resource.data.patientId != null &&
      (
        // If department is NOT specified, allow (for completion records, etc.)
        !request.resource.data.keys().hasAny(['department']) ||
        // If department IS specified, must be from approved list
        (request.resource.data.keys().hasAny(['department']) &&
        request.resource.data.get('department', '') in [
          'Out-Patient Department (OPD)',
          'Specialist Department',
          'Emergency Department',
          'Surgery Department',
          'Inpatient Department (IPD)',
          'In-Patient Department (IPD)',
          'Maternity Department',
          'Pediatric Department',
          'Nursing Department'
        ])
      );
      
      // FACILITY STAFF READ ACCESS - Allow reading health records for their facility
      // Staff can read records that belong to their facility
      allow read: if resource.data.facilityId != null || true; // Allow reading for facility staff
      
      // Admin can do anything
      allow read, write, delete: if isAdmin();
      // List: allow for authenticated users and facility staff
      allow list: if isAuthenticated() || true;
    }

    // CHW CONSULTATION RECORDS COLLECTION - Filtered access for CHW-Doctor consultations
    match /chw_consultation_records/{recordId} {
      // CHWs can only read their own consultation records (filtered data on client-side)
      allow read: if isAuthenticated() && resource.data.chwId == request.auth.uid;
      
      // Doctors can read/write their own consultation records
      allow read, write: if isDoctor() && resource.data.doctorId == request.auth.uid;
      
      // Doctors can create new consultation records
      allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid;
      
      // Admin has full access for oversight and management
      allow read, write, delete: if isAdmin();
      
      // List permissions for authenticated providers
      allow list: if isAuthenticated() && (isDoctor() || isCHWWithoutApproval() || isAdmin());
    }

    // BLOCK WRITES TO OLD COLLECTIONS
    match /consultations/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    match /lab_request/{docId} {
      allow read: if isAuthenticated();
      allow write, delete: if false;
    }
    match /prescriptions/{docId} {
      allow read: if isAuthenticated();
      allow update: if true;
      allow create, delete: if false;
    }

    // VITALS RECORDS COLLECTION - For nursing staff to record vital signs
    match /vitals_records/{vitalId} {
      // Allow authenticated users to read vitals
      allow read: if isAuthenticated();
      // Allow authenticated facility staff and nursing to create/update vitals
      allow create, update: if isAuthenticated() && (isFacility() || isDoctor() || isCHWWithoutApproval());
      // Allow facility staff to create vitals even without full authentication (staff tokens)
      allow create: if request.resource.data.keys().hasAll([
        'patientId', 'facilityId', 'recordedBy'
      ]) && request.resource.data.facilityId != null;
      // Admin full access
      allow read, write, delete: if isAdmin();
      // List for authenticated users
      allow list: if isAuthenticated() || true; // Allow listing for facility staff
    }

    // FACILITY PATIENTS VITALS SUBCOLLECTION - For individual patient vital history
    match /facility_patients/{patientId}/vitals/{vitalId} {
      // Allow reading vitals for authenticated users
      allow read: if isAuthenticated();
      // Allow writing vitals for facility staff and healthcare providers
      allow write: if isAuthenticated() && (isFacility() || isDoctor() || isCHWWithoutApproval());
      // Allow facility staff to create vitals (with proper facility validation)
      allow create: if request.resource.data.facilityId != null && 
        request.resource.data.patientId == patientId;
      // Admin full access
      allow read, write, delete: if isAdmin();
      // List for authenticated users
      allow list: if isAuthenticated() || true; // Allow listing for facility staff
    }

    // WARDS COLLECTION - Ward management for hospitals
    match /wards/{wardId} {
      // Allow anyone to read wards (needed for dropdowns and ward selection)
      allow read, list: if true;
      // Allow facility staff to create and update wards
      allow create, update: if request.resource.data.facilityId != null;
      // Allow facility to delete their own wards
      allow delete: if resource.data.facilityId != null;
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // BEDS COLLECTION - Bed management for wards
    match /beds/{bedId} {
      // Allow anyone to read beds (needed for dropdowns and bed selection)
      allow read, list: if true;
      // Allow facility staff to create, update, and write beds
      allow create, update, write: if request.resource.data.facilityId != null;
      // Allow facility to delete their own beds
      allow delete: if resource.data.facilityId != null;
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // TRANSFER HISTORY COLLECTION - Track patient transfers between wards
    match /transfer_history/{transferId} {
      // Allow anyone to read transfer history (needed for audit and tracking)
      allow read, list: if true;
      // Allow facility staff to create transfer records
      allow create: if request.resource.data.facilityId != null;
      // No updates or deletes allowed for audit integrity
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // INPATIENTS COLLECTION - In-patient records management
    match /inpatients/{inpatientId} {
      // Allow anyone to read inpatients (needed for ward management)
      allow read, list: if true;
      
      // FACILITY STAFF ACCESS - RESTRICTED TO CLINICAL DEPARTMENTS
      // Only clinical departments can admit patients (create inpatient records)
      // Must include department field to indicate which department is performing the admission
      allow create, update: if request.resource.data.facilityId != null &&
      (
        // Allow if department field exists and matches approved clinical departments
        request.resource.data.keys().hasAny(['department']) &&
        request.resource.data.get('department', '') in [
          'Out-Patient Department (OPD)',
          'Specialist Department',
          'Emergency Department',
          'Surgery Department',
          'In-Patient'
        ]
      );
      
      // Allow facility to delete/discharge their own inpatients
      allow delete: if resource.data.facilityId != null;
      // Admin full access
      allow read, write, delete: if isAdmin();
      
      // BILLING ACTIVITIES SUBCOLLECTION - Activity logs for billing
      match /billing_activities/{activityId} {
        // Allow anyone to read billing activities
        allow read, list: if true;
        // Allow facility staff to create billing activities
        allow create: if request.resource.data.keys().hasAll(['type', 'performedBy']);
        // Only admin can update/delete activities
        allow update, delete: if isAdmin();
      }
    }

    // PATIENT BILLS COLLECTION - Billing records for in-patient services
    match /patient_bills/{billId} {
      // Allow anyone to read bills (needed for billing management)
      allow read, list: if true;
      
      // Allow facility staff to create and update bills
      // Must include facilityId, patientId, serviceId, and amount
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['patientId', 'serviceId', 'totalAmount', 'status']);
      
      // Allow facility to delete their own bills
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // ADMISSIONS COLLECTION - Patient admissions to wards
    match /admissions/{admissionId} {
      // Allow anyone to read admissions (needed for ward management and in-patient tracking)
      allow read, list: if true;
      
      // FACILITY STAFF ACCESS - Allow create/update/write if facilityId is present
      // For creates: check request.resource.data.facilityId (new data must have facilityId)
      // For updates/writes: allow if either existing doc has facilityId OR the update includes facilityId
      // This handles both new documents and updates to old documents that may not have facilityId yet
      allow create: if request.resource.data.facilityId != null;
      allow update, write: if request.resource.data.facilityId != null;
      
      // Allow facility to delete/discharge their own admissions
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
      
      // WARD ROUNDS SUBCOLLECTION - Daily ward round notes
      match /ward_rounds/{roundId} {
        // Allow anyone to read ward rounds
        allow read, list: if true;
        // Allow facility staff to create and update ward rounds
        allow create, update: if true;
        // Only admin can delete ward rounds
        allow delete: if isAdmin();
      }
      
      // VITAL SIGNS SUBCOLLECTION - Patient vitals in ward (matches code: vital_signs)
      match /vital_signs/{vitalId} {
        // Allow anyone to read vital signs
        allow read, list: if true;
        // Allow facility staff to create and update vital signs
        allow create, update: if true;
        // Only admin can delete vital signs
        allow delete: if isAdmin();
      }
      
      // MEDICATIONS SUBCOLLECTION - Medications administered in ward
      match /medications/{medicationId} {
        // Allow anyone to read medications
        allow read, list: if true;
        // Allow facility staff to create and update medications
        allow create, update: if true;
        // Only admin can delete medications
        allow delete: if isAdmin();
      }
      
      // DAILY REPORTS SUBCOLLECTION - 24-hour nursing reports
      match /daily_reports/{reportId} {
        // Allow anyone to read daily reports
        allow read, list: if true;
        // Allow facility staff to create and update daily reports
        allow create, update: if true;
        // Only admin can delete daily reports
        allow delete: if isAdmin();
      }
    }

    // PATIENT DAILY REPORTS COLLECTION - Main storage for nursing daily reports
    match /patient_daily_reports/{reportId} {
      // Allow anyone to read daily reports (needed for medical records)
      allow read, list: if true;
      // Allow facility staff to create daily reports if facilityId is present
      allow create: if request.resource.data.facilityId != null;
      // Allow facility staff to update their own facility's reports
      allow update: if resource.data.facilityId != null || request.resource.data.facilityId != null;
      // Only admin can delete daily reports
      allow delete: if isAdmin();
    }

    // REFUND APPLICATIONS COLLECTION - Patient wallet refund requests
    match /refund_applications/{applicationId} {
      // Allow anyone to read refund applications (needed for medical records and admin)
      allow read, list: if true;
      
      // Allow facility staff (medical records) to create refund applications
      // Must include facilityId, patientId, refundAmount, and reason
      allow create: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['patientId', 'refundAmount', 'refundReason', 'applicantId']);
      
      // Allow medical records to update their applications (before admin approval)
      allow update: if resource.data.facilityId != null &&
        resource.data.status == 'draft';
      
      // Admin and facility admin can update (for approval/rejection)
      allow update: if resource.data.facilityId != null ||
        isAdmin();
      
      // Only admin can delete refund applications
      allow delete: if isAdmin();
      
      // Subcollections for audit trail
      match /verification_logs/{logId} {
        allow read, list: if true;
        allow create: if true; // Created by cloud functions
        allow update, delete: if isAdmin();
      }
      
      match /approval_logs/{logId} {
        allow read, list: if true;
        allow create: if true; // Created by cloud functions
        allow update, delete: if isAdmin();
      }
    }

    // PATIENT REFUND APPLICATIONS COLLECTION - Independent/remote patients wallet refund requests
    match /patient_refund_applications/{applicationId} {
      // Patients can read their own applications
      allow read: if request.auth != null && 
        resource.data.patientId == request.auth.uid;
      
      // Patients can create refund applications for themselves
      allow create: if request.auth != null &&
        request.resource.data.patientId == request.auth.uid &&
        request.resource.data.keys().hasAll(['amount', 'bankCode', 'accountNumber', 'reason']);
      
      // Admin can read and update all applications (for approval/rejection)
      allow read, update: if isAdmin();
      
      // Admin can list all applications
      allow list: if isAdmin();
      
      // Only admin can delete patient refund applications
      allow delete: if isAdmin();
      
      // Subcollections for audit trail
      match /approval_logs/{logId} {
        allow read: if request.auth != null;
        allow create: if true; // Created by cloud functions
        allow update, delete: if isAdmin();
      }
    }

    // NURSING PROCEDURES COLLECTION - For nursing staff to record procedures
    match /nursing_procedures/{procedureId} {
      // Allow anyone to read procedures
      allow read, list: if true;
      // Allow facility staff to create and update procedures
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['patientId', 'procedureName', 'performedBy']);
      // Allow facility to delete their own procedures
      allow delete: if resource.data.facilityId != null;
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // SERVICE REQUESTS COLLECTION - Pharmacy orders, lab tests, imaging requests
    match /service_requests/{requestId} {
      // Allow anyone to read service requests
      allow read, list: if true;
      // Allow anyone to create service requests (phone-authenticated patients need this)
      allow create: if true;
      // Allow updates for processing
      allow update: if true;
      // Only admin can delete
      allow delete: if isAdmin();
    }

    // NOTIFICATIONS COLLECTION - User notifications
    match /notifications/{notificationId} {
      // Allow anyone to read and create notifications
      allow read, list: if true;
      // Allow anyone to create notifications (for phone-authenticated patients)
      allow create: if true;
      // Allow updates for marking as read
      allow update: if true;
      // Only admin can delete notifications
      allow delete: if isAdmin();
    }

    // GEMINI AI CONFIGURATION - Read-only for authenticated users
    match /app_config/gemini {
      // Any authenticated user can read the Gemini API configuration
      allow read: if request.auth != null;
      // Only admins can write via Firebase Console (no write access from app)
      allow write: if false;
    }

    // ENVIRONMENTAL INSPECTIONS COLLECTION - Environmental health surveillance
    match /environmental_inspections/{inspectionId} {
      // Allow anyone to read environmental inspections
      allow read, list: if true;
      
      // Allow facility staff to create and update inspections
      // Must include facilityId, inspectionType, and inspectorId
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['inspectionType', 'inspectorId', 'department']);
      
      // Allow facility to delete their own inspections
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // DISEASE SURVEILLANCE CASES COLLECTION - Disease surveillance and outbreak management
    match /disease_surveillance_cases/{caseId} {
      // Allow anyone to read disease surveillance cases
      allow read, list: if true;
      
      // Allow facility staff to create and update disease cases
      // Must include facilityId, disease, reportedBy, and reportedById
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['disease', 'reportedBy', 'reportedById']);
      
      // Allow facility to delete their own cases
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // HAI SURVEILLANCE COLLECTION - Healthcare-Associated Infection surveillance
    match /hai_surveillance/{recordId} {
      // Allow anyone to read HAI surveillance records
      allow read, list: if true;
      
      // Allow facility staff to create and update HAI records
      // Must include facilityId, infectionType, reportedBy, and reportedById
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['infectionType', 'reportedBy', 'reportedById']);
      
      // Allow facility to delete their own records
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // HAND HYGIENE OBSERVATIONS COLLECTION - Hand hygiene compliance monitoring
    match /hand_hygiene_observations/{observationId} {
      // Allow anyone to read hand hygiene observations
      allow read, list: if true;
      
      // Allow facility staff to create and update observations
      // Must include facilityId, moment, observedBy, and observedById
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['moment', 'observedBy', 'observedById']);
      
      // Allow facility to delete their own observations
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // OUTBREAK INVESTIGATIONS COLLECTION - Hospital outbreak tracking and investigation
    match /outbreak_investigations/{outbreakId} {
      // Allow anyone to read outbreak investigations
      allow read, list: if true;
      
      // Allow facility staff to create and update outbreak reports
      // Must include facilityId, disease, and reportedById
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['disease', 'reportedById']);
      
      // Allow facility to delete their own outbreak reports
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // OUTBREAK CASES COLLECTION - Line listing of individual outbreak cases
    match /outbreak_cases/{caseId} {
      // Allow anyone to read outbreak cases
      allow read, list: if true;
      
      // Allow facility staff to create and update case records
      // Must include facilityId, caseId, and dateOfOnset
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['caseId', 'dateOfOnset']);
      
      // Allow facility to delete their own case records
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // OUTBREAK CONTACTS COLLECTION - Contact tracing records
    match /outbreak_contacts/{contactId} {
      // Allow anyone to read contact records
      allow read, list: if true;
      
      // Allow facility staff to create and update contact records
      // Must include facilityId, name, and contactType
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['name', 'contactType', 'dateIdentified']);
      
      // Allow facility to delete their own contact records
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // HEALTH EDUCATION SESSIONS COLLECTION - Community health education programs
    match /health_education_sessions/{sessionId} {
      // Allow anyone to read health education sessions
      allow read, list: if true;
      
      // Allow facility staff to create and update sessions
      // Must include facilityId, topic, venue, and targetAudience
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['topic', 'venue', 'targetAudience', 'sessionDate']);
      
      // Allow facility to delete their own sessions
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // HEALTH OUTREACH ACTIVITIES COLLECTION - Community health outreach and mobile clinics
    match /health_outreach_activities/{activityId} {
      // Allow anyone to read health outreach activities
      allow read, list: if true;
      
      // Allow facility staff to create and update outreach activities
      // Must include facilityId, activityType, location, and targetPopulation
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['activityType', 'location', 'targetPopulation', 'activityDate']);
      
      // Allow facility to delete their own activities
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // IMMUNIZATION RECORDS COLLECTION - Individual immunization records
    match /immunization_records/{recordId} {
      // Allow anyone to read immunization records
      allow read, list: if true;
      
      // Allow facility staff to create and update immunization records
      // Must include facilityId, vaccineName, and dateAdministered
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['vaccineName', 'dateAdministered', 'administeredBy']);
      
      // Allow facility to delete their own records
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // IMMUNIZATIONS COLLECTION - Immunization schedules and appointments
    match /immunizations/{immunizationId} {
      // Allow anyone to read immunization schedules
      allow read, list: if true;
      
      // Allow facility staff to create and update immunization schedules
      // Must include facilityId and scheduledDate
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['scheduledDate']);
      
      // Allow facility to delete their own schedules
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // COLD CHAIN LOGS COLLECTION - Vaccine storage temperature monitoring
    match /cold_chain_logs/{logId} {
      // Allow anyone to read cold chain logs
      allow read, list: if true;
      
      // Allow facility staff to create and update cold chain logs
      // Must include facilityId, temperature, and loggedBy
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['temperature', 'loggedBy', 'loggedAt']);
      
      // Allow facility to delete their own logs
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // ADVERSE EVENTS COLLECTION - Adverse events following immunization (AEFI)
    match /adverse_events/{eventId} {
      // Allow anyone to read adverse event reports
      allow read, list: if true;
      
      // Allow facility staff to create and update adverse event reports
      // Must include facilityId, eventType, and reportedBy
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['eventType', 'reportedBy', 'reportedAt']);
      
      // Allow facility to delete their own reports
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // VACCINE INVENTORY COLLECTION - Vaccine stock management
    match /vaccine_inventory/{inventoryId} {
      // Allow anyone to read vaccine inventory
      allow read, list: if true;
      
      // Allow facility staff to create and update vaccine inventory
      // Must include facilityId, vaccineName, and currentStock
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['vaccineName', 'currentStock']);
      
      // Allow facility to delete their own inventory records
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // VACCINE STOCK COLLECTION - Vaccine stock tracking
    match /vaccine_stock/{stockId} {
      // Allow anyone to read vaccine stock
      allow read, list: if true;
      
      // Allow facility staff to create and update vaccine stock
      // Must include facilityId
      allow create, update: if request.resource.data.facilityId != null;
      
      // Allow facility to delete their own stock records
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // PUBLIC HEALTH SURVEYS COLLECTION - Community health surveys
    match /public_health_surveys/{surveyId} {
      // Allow anyone to read public health surveys
      allow read, list: if true;
      
      // Allow facility staff to create and update surveys
      // Must include facilityId, surveyType, and createdBy
      allow create, update: if request.resource.data.facilityId != null &&
        request.resource.data.keys().hasAll(['surveyType', 'createdBy']);
      
      // Allow facility to delete their own surveys
      allow delete: if resource.data.facilityId != null;
      
      // Admin full access
      allow read, write, delete: if isAdmin();
    }

    // Course collections - Admin write, role-based read
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /courseSlides/{slideId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /courseProgress/{progressId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /certificateAccess/{accessId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isAuthenticated() &&
        isValidCertificateAccessPayload() &&
        isOwnCertificateAccessId(accessId, request.resource.data.courseId)
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.courseId == resource.data.courseId &&
        isValidCertificateAccessPayload() &&
        isOwnCertificateAccessId(accessId, resource.data.courseId)
      );
      allow delete: if isAdmin();
    }

    match /courseCertificates/{certificateDocId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.courseId is string &&
        request.resource.data.certificateId is string &&
        request.resource.data.certificateId.size() > 0 &&
        certificateDocId == request.auth.uid + '_' + request.resource.data.courseId &&
        hasCertificateAccess(certificateDocId);
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.courseId == resource.data.courseId &&
        request.resource.data.certificateId == resource.data.certificateId &&
        hasCertificateAccess(certificateDocId);
      allow delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // All other collections with basic rules...
    match /{collectionId}/{document=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        !(collectionId in [
          'courseProgress',
          'certificateAccess',
          'courseCertificates'
        ]);
    }
  }
}
