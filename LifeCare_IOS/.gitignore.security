# Security Files - Never commit these to version control
.env
.env.local
.env.production
.env.development

# Firebase private keys
firebase-adminsdk-*.json
serviceAccountKey.json
google-services.json

# API Keys and secrets
**/api_keys.dart
**/secrets.dart

# Build files that might contain keys
build/
.dart_tool/

# IDE files
.vscode/settings.json
.idea/

# Logs that might contain sensitive info
*.log
logs/

# Temporary files
*.tmp
*.temp