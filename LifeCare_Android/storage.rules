rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only allow users to access files in their own folder
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to upload help videos (admin validation will be done in app logic)
    match /help_videos/{allPaths=**} {
      allow read: if true; // Public read access for help videos
      allow write: if request.auth != null; // Authenticated users can write (admin check in app)
    }
    
    // Allow authenticated users to upload training materials (admin validation will be done in app logic)
    match /training_materials/{allPaths=**} {
      allow read: if true; // Public read access for training materials
      allow write: if request.auth != null; // Authenticated users can write (admin check in app)
    }
    
    // Allow facility document uploads during registration
    match /facility_docs/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read
      allow write: if request.auth != null; // Authenticated users can upload their documents
    }
    
    // Allow CHW document uploads during registration
    match /chw_documents/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read
      allow write: if request.auth != null; // Authenticated users can upload their documents
    }
    
    // Allow doctor document uploads during registration
    match /doctor_documents/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read
      allow write: if request.auth != null; // Authenticated users can upload their documents
    }
    
    // Allow profile pictures and general documents
    match /profile_pictures/{allPaths=**} {
      allow read: if true; // Public read for profile pictures
      allow write: if request.auth != null; // Authenticated users can upload
    }
    
    match /documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Allow facility logos - publicly readable
    match /facility_logos/{allPaths=**} {
      allow read: if true; // Public read for facility logos
      allow write: if request.auth != null; // Authenticated users can upload
    }
    
    // Allow facility documents - authenticated read
    match /facility_documents/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read
      allow write: if request.auth != null; // Authenticated users can upload
    }

    // IPC custom surveillance form attachments
    match /ipc_custom_surveillance/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 20 * 1024 * 1024;
    }

    // Saved generated IPC surveillance reports/downloads
    match /ipc_surveillance_downloads/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 20 * 1024 * 1024;
      allow delete: if true;
    }
    // COURSE MEDIA UPLOADS
match /course_media/{allPaths=**} {
  allow read: if true;
  allow write: if request.auth != null;
}

    // CERTIFICATE SIGNATURE UPLOADS
    match /course_signatures/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
